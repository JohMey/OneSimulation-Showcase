#2812 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#2813 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(2.E-04),#2810,
  'distance_accuracy_value','confusion accuracy');
#2814 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#7));
ENDSEC;
END-ISO-10303-21;
